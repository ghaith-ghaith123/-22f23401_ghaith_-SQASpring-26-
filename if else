#include <iostream> 

using namespace std; 

  

int main() { 

    int touristCount; 

     

    cout << "Enter tourist count: "; 

    cin >> touristCount; 

     

    if (touristCount < 0) { 

        cout << "Error: Invalid count" << endl; 

    } 

    else if (touristCount <= 500) { 

        cout << "Dashboard: LOW crowd" << endl; 

    } 

    else if (touristCount <= 1500) { 

        cout << "Dashboard: MEDIUM crowd" << endl; 

    } 

    else if (touristCount <= 3000) { 

        cout << "Dashboard: HIGH crowd" << endl; 

    } 

    else { 

        cout << "Dashboard: CRITICAL crowd - Alert!" << endl; 

    } 

     

    return 0; 

} 
